# ── База данных ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:L7062006v.@localhost:54329/moviedb

# ── Kinopoisk API Unofficial ──────────────────────────────
# Токен: https://kinopoiskapiunofficial.tech
KINOPOISK_API_TOKEN=be3d601e-35cf-4e76-880d-fe3bc496aeea
KINOPOISK_API_URL=https://kinopoiskapiunofficial.tech

# Автозагрузка каталога при старте API
KINOPOISK_STARTUP_SYNC_ENABLED=true
# 0 — пройти все страницы, которые вернет /api/v2.2/films
KINOPOISK_STARTUP_SYNC_MAX_PAGES=0
KINOPOISK_SYNC_REQUEST_DELAY_SECONDS=0.25
KINOPOISK_SYNC_ORDER=RATING
# Пусто — все типы; можно указать FILM, TV_SERIES, MINI_SERIES и т.п.
KINOPOISK_SYNC_TYPE=
# Сначала грузим коллекции, потом дополняем ограниченным /api/v2.2/films
KINOPOISK_SYNC_USE_FILTERS=true
KINOPOISK_SYNC_COLLECTION_TYPES=TOP_POPULAR_ALL,TOP_POPULAR_MOVIES,TOP_250_MOVIES,TOP_250_TV_SHOWS,POPULAR_SERIES,FAMILY,KIDS_ANIMATION_THEME,COMICS_THEME,CATASTROPHE_THEME,LOVE_THEME,ZOMBIE_THEME,VAMPIRE_THEME
KINOPOISK_SYNC_COLLECTION_MAX_PAGES=50
# true делает детальные запросы по каждому фильму; быстро расходует дневную квоту
KINOPOISK_SYNC_FETCH_DETAILS=false
# true — при открытии фильма подтягивать описание, если его еще нет в БД
KINOPOISK_ENRICH_ON_DETAIL_ENABLED=true

# ── Кэш фильмов ──────────────────────────────────────────
# TTL 0 отключает кэш
MOVIE_CACHE_TTL_SECONDS=300
MOVIE_CACHE_MAX_SIZE=512

# ── Плееры-агрегаторы ─────────────────────────────────────
# Kodik: регистрация https://kodik.info/reg
KODIK_TOKEN=

# Alloha: регистрация https://alloha.tv
ALLOHA_TOKEN=

# VideoCDN: регистрация https://videocdn.tv
VIDEOCDN_TOKEN=

# Bazon (bhcesh): регистрация https://bhcesh.me
BAZON_TOKEN=

# iframe.video — публичный, токен не нужен
